# 依赖
node_modules/
.pnp
.pnp.js

# 构建产物
dist/
dist-ssr/
build/
*.local

# TypeScript 增量编译缓存
*.tsbuildinfo

# Vite / Vitest 临时文件（配置文件的时间戳副本）
vite.config.ts.timestamp-*
vitest.config.ts.timestamp-*

# 测试覆盖率
coverage/

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量
.env
.env.*
!.env.example

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 抓取脚本产生的中间文件
scripts/.cache/
scripts/tmp/

# 价格抓取产物（含自检假数据，由 fetch-jd-union.mjs 生成，不进仓库）
# 只忽略**根目录**的 data/：写成 `data/` 会连带屏蔽 src/data/ 下的新建文件，
# 导致新参数文件被静默忽略、git add -A 也捡不到。
/data/

# 本地单文件预览产物（standalone.html 是内联打包的大文件，不进仓库）
preview/

# WorkBuddy 本地记忆与工作区文件
.workbuddy/
.wbapp_*.genie

# socpk.com 原始 API 转储（可由脚本重新抓取，charge-curves 单文件 3MB+，不进仓库）
research/socpk-raw/
